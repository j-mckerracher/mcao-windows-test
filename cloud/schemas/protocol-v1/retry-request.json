{
  "additionalProperties": false,
  "description": "expected_* are compare-and-set preconditions, never assignments.",
  "properties": {
    "expected_attempt": {
      "minimum": 1,
      "title": "Expected Attempt",
      "type": "integer",
      "x-origin": "client-manifest"
    },
    "expected_version": {
      "minimum": 0,
      "title": "Expected Version",
      "type": "integer",
      "x-origin": "client-manifest"
    },
    "protocol_version": {
      "const": "v1",
      "title": "Protocol Version",
      "type": "string",
      "x-origin": "client-manifest"
    },
    "request_uuid": {
      "format": "uuid",
      "title": "Request Uuid",
      "type": "string",
      "x-origin": "client-manifest"
    }
  },
  "required": [
    "protocol_version",
    "request_uuid",
    "expected_attempt",
    "expected_version"
  ],
  "title": "RetryRequest",
  "type": "object",
  "x-forbidden-inputs": [
    "access_token",
    "actor",
    "argv",
    "attempt",
