    "environment",
    "fence",
    "fence_token",
    "id_token",
    "image",
    "image_digest",
    "image_ref",
    "local_path",
    "owner",
    "owner_id",
    "path",
    "principal",
    "run_id",
    "runtime_identity",
    "secret",
    "secret_name",
    "secret_ref",
    "secrets",
    "server_id",
    "service_account",
    "service_account_email",
    "signed_url",
    "source_bytes",
    "source_content",
    "token",
    "upload_url",
    "url"
  ]
