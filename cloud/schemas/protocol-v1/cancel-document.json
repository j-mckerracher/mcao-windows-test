{
  "additionalProperties": false,
  "description": "Controller-written cancel directive for one attempt. Create-only, so it is monotonic.\n\nOnce written it is never rewritten or removed, and a retried write is a no-op. It names the\nfenced attempt it stops and grants the runner no write authority.",
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "claim_id": {
      "pattern": "^claim_[0-9a-f]{32}$",
      "title": "Claim Id",
      "type": "string"
    },
    "fence": {
      "minimum": 1,
      "title": "Fence",
      "type": "integer"
    },
    "protocol_version": {
      "const": "v1",
      "title": "Protocol Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "protocol_version",
    "run_id",
    "attempt",
    "fence",
    "claim_id"
  ],
  "title": "CancelDocument",
  "type": "object"
}
